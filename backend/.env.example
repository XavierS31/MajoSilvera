# Server
PORT=5000
NODE_API_PORT=8000
NODE_ENV=development

# PostgreSQL / AWS RDS Connection
# Use either DATABASE_URL (preferred) or all five DB_* values below. URL-encode
# reserved characters in the user name or password when using DATABASE_URL.
DATABASE_URL=postgresql://postgres_user:password@your-rds-endpoint.region.rds.amazonaws.com:5432/majosilvera_db
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=majosilvera_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_password

# AWS RDS requires TLS. Keep certificate verification enabled; only set this to
# false temporarily if you have not yet configured the RDS CA certificate chain.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# PostgreSQL Connection Pool Configuration (keep Lambda pools small)
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# OAuth2 Configuration
OAUTH2_PROVIDER=google
OAUTH2_CLIENT_ID=your_oauth2_client_id
OAUTH2_CLIENT_SECRET=your_oauth2_client_secret
OAUTH2_TOKEN_INTROSPECT_URL=https://your-auth-provider/oauth/token/introspect
ADMIN_EMAIL=admin@example.com

# Python Gemini Chatbot & Rate Limits
GEMINI_API_KEY=your_gemini_api_key
CHATBOT_MAX_TOKENS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Caching Configuration
CACHE_TTL_SECONDS=3600
CHATBOT_URL=http://127.0.0.1:8001
CHATBOT_SHARED_SECRET=

# Calendly Integration
CALENDLY_API_TOKEN=replace_with_your_calendly_api_token
CALENDLY_SCHEDULING_URL=https://calendly.com/your-account/your-event
