# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres_user:password@localhost:5432/majosilvera_db

# OAuth2 Configuration
OAUTH2_CLIENT_ID=your_oauth2_client_id
OAUTH2_CLIENT_SECRET=your_oauth2_client_secret
OAUTH2_TOKEN_INTROSPECT_URL=https://your-auth-provider/oauth/token/introspect

# Python Gemini Chatbot & Rate Limits
GEMINI_API_KEY=your_gemini_api_key
CHATBOT_MAX_TOKENS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Caching Configuration
CACHE_TTL_SECONDS=3600
CHATBOT_URL=http://localhost:8000
CHATBOT_SHARED_SECRET=
